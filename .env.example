# Скопируйте значения в переменные окружения хостинга. Сам файл .env не коммитится.
ANTHROPIC_API_KEY=
IG_APP_SECRET=
IG_APP_ID=                          # Instagram app ID, для ссылки подключения мастера
IG_ACCESS_TOKEN=
IG_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Необязательные настройки (значения по умолчанию)
CLAUDE_MODEL=claude-opus-5-5        # при перерасходе: claude-sonnet-5-5
CLAUDE_EFFORT=medium                # low | medium | high
APPROVAL_MODE=true                  # первая неделя: черновики в Telegram
ATTACH_IMAGES=true                  # модель видит фото-референсы клиента
TOPIC_FILTER=true                   # бот отвечает только в диалогах про тату
SKIP_EXISTING_CONTACTS=true         # не трогать тех, с кем мастер переписывалась до запуска
BOT_LAUNCH_DATE=                    # например 2026-12-01; пусто: дата первого запуска
CLASSIFIER_MODEL=claude-haiku-5-5
MONTHLY_BUDGET_USD=100
SUMMARY_HOUR_UTC=18
DEBOUNCE_SECONDS=4
RETENTION_DAYS=90
GRAPH_API_VERSION=v24.0
STUDIO_NAME=
PLAYGROUND_TOKEN=                   # пароль тестового чата /playground; пусто: выключен
PUBLIC_URL=                         # на Railway не нужен: берётся из RAILWAY_PUBLIC_DOMAIN
PRIVACY_CONTACT=
DB_PATH=data/agent.db
